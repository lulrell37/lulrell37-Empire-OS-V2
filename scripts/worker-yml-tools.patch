+              echo "  transcripts: node scripts/jarvis-tool.js '[TRANSCRIBE: https://youtu.be/...]'"
+              echo "  relay to a persona: node scripts/jarvis-tool.js '[RELAY_TO: scribe | write a 40-word bio for Empire Digital]'"
+              echo "  memory: node scripts/jarvis-tool.js '[MEMORY_QUERY: what did we decide about pricing]'"
