# Copy to server/.env for local dev. On the Replit Deployment set these as
# Secrets instead (DATABASE_URL is injected automatically there).

DATABASE_URL=postgres://user:pass@host:5432/dbname
SYNC_TOKEN=replace-with-a-long-random-string

ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# PORT is provided by the host in production; 3000 for local dev.
PORT=3000
# Set to "disable" only for a plain local Postgres with no SSL.
# PGSSL=disable
# Set to "off" to stop this instance running the scheduled nudge cron.
# NUDGES=off
# Set to "off" to disable the 05:10 ET daily-briefing cron.
# DAILY_BRIEFING=off
# Set to "off" to disable the 05:00 ET nightly Empire Council cron.
# COUNCIL=off
# Council tunables (defaults shown).
# COUNCIL_ROUNDS=2
# COUNCIL_RESEARCH_MAX=8
# COUNCIL_SEARCH_MAX=6

# Telegram bots — one per persona, all locked to TELEGRAM_OWNER_ID. Set only the
# ones you want live. PUBLIC_URL auto-registers every webhook on boot.
TELEGRAM_OWNER_ID=
# PUBLIC_URL=https://your-deployment.example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_STEPHANIE=
TELEGRAM_BOT_TOKEN_HAVEN=
TELEGRAM_BOT_TOKEN_JARVIS=
TELEGRAM_BOT_TOKEN_SELENE=

# Server-side S.C.O.U.T. intent-signal cron. OFF unless SCOUT_CRON=on.
# SCOUT_CRON=on
# SCOUT_INTERVAL_MIN=30
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
YELP_API_KEY=
